{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "kyc_level": { "type": "number", "enum": [0, 1, 2, 3] },
        "status": { "type": "string", "enum": ["active", "suspended", "pending_verification"] },
        "transaction_pin": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "first_name", "last_name", "email", "kyc_level", "status", "created_at"]
    },
    "Wallet": {
      "title": "User Wallet",
      "description": "User digital wallet details and cached balance fields",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "currency": { "type": "string" },
        "available_balance": { "type": "number" },
        "ledger_balance": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "frozen"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "user_id",
        "currency",
        "available_balance",
        "ledger_balance",
        "status",
        "created_at"
      ]
    },
    "LedgerEntry": {
      "title": "Ledger Entry",
      "description": "A double-entry financial ledger record. Immutable after creation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wallet_id": { "type": "string" },
        "reference": { "type": "string" },
        "type": { "type": "string", "enum": ["credit", "debit"] },
        "credit": { "type": "number" },
        "debit": { "type": "number" },
        "balance_after": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "reversed"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "wallet_id",
        "reference",
        "type",
        "credit",
        "debit",
        "balance_after",
        "description",
        "status",
        "created_at"
      ]
    },
    "Transaction": {
      "title": "Transaction Log",
      "description": "Detailed log of transaction items (such as airtime, data, transfers)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reference": { "type": "string" },
        "user_id": { "type": "string" },
        "service": {
          "type": "string",
          "enum": ["airtime", "data", "electricity", "cable", "transfer", "fund_wallet"]
        },
        "provider": { "type": "string" },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "provider_reference": { "type": "string" },
        "metadata": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "reference",
        "user_id",
        "service",
        "provider",
        "amount",
        "fee",
        "status",
        "created_at"
      ]
    },
    "Beneficiary": {
      "title": "Saved Beneficiary",
      "description": "Saved beneficiary bank details for ease of future transfers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "bank": { "type": "string" },
        "account_number": { "type": "string" },
        "account_name": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "bank", "account_number", "account_name", "created_at"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications sent to users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "title", "message", "type", "is_read", "created_at"]
    },
    "Referral": {
      "title": "Referral Record",
      "description": "Referral details linking a referrer to a referred user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referrer": { "type": "string" },
        "referred_user": { "type": "string" },
        "reward": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referrer", "referred_user", "reward", "status", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection"
    },
    "/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "Wallets collection mapping wallets to users"
    },
    "/wallets/{walletId}/ledger/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Double-entry ledger history for auditing balances"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Consolidated logs for payment and transfer transactions"
    },
    "/beneficiaries/{beneficiaryId}": {
      "schema": { "$ref": "#/entities/Beneficiary" },
      "description": "Users saved beneficiaries list"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System-wide and user-specific notification logs"
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Referral logs for promotional rewards"
    }
  }
}
